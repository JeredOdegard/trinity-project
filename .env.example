# Local: npm run db:local starts an embedded Postgres (PGlite) on 5433
DATABASE_URL=postgres://postgres@localhost:5433/postgres
ADMIN_PASSWORD=change-me
# Leaves per rain level (level 1 at 500, level 2 at 1000, ... max 5)
RAIN_GOAL=500
# Base URL printed into QR codes
SITE_URL=http://localhost:3000
